    {
      "name": "03 - Correlation id",
      "item": [
        {
          "name": "No X-Request-Id: one is generated",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{superAdminAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayBaseUrl}}/api/v1/wards",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "wards"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('X-Request-Id returned', function () { pm.expect(pm.response.headers.get('X-Request-Id')).to.match(/^[0-9a-f-]{36}$/); });"
                ]
              }
            }
          ]
        },
        {
          "name": "X-Request-Id echoed",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{superAdminAccessToken}}"
              },
              {
                "key": "X-Request-Id",
                "value": "pm-gw-{{runId}}"
              }
            ],
            "url": {
              "raw": "{{gatewayBaseUrl}}/api/v1/wards",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "wards"
              ]
            },
            "description": "The gateway log has: requestId=pm-gw-<runId> GET /api/v1/wards -> 200 OK route=ward"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Same id back', function () { pm.expect(pm.response.headers.get('X-Request-Id')).to.eql('pm-gw-' + pm.environment.get('runId')); });"
                ]
              }
            }
          ]
        },
        {
          "name": "401s carry X-Request-Id too",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayBaseUrl}}/api/v1/wards",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "wards"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', function () { pm.response.to.have.status(401); });",
                  "pm.test('X-Request-Id on the 401', function () { pm.expect(pm.response.headers.get('X-Request-Id')).to.be.a('string'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 - CORS",
      "item": [
        {
          "name": "Preflight from http://localhost:5173 (200)",
          "request": {
            "method": "OPTIONS",
            "header": [
              {
                "key": "Origin",
                "value": "http://localhost:5173"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "POST"
              },
              {
                "key": "Access-Control-Request-Headers",
                "value": "authorization,content-type,x-request-id"
              }
            ],
            "url": {
              "raw": "{{gatewayBaseUrl}}/api/v1/patients",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "patients"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Origin allowed, Authorization allowed', function () {",
                  "    pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.eql('http://localhost:5173');",
                  "    pm.expect(pm.response.headers.get('Access-Control-Allow-Headers').toLowerCase()).to.include('authorization');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Preflight from a disallowed origin (403)",
          "request": {
            "method": "OPTIONS",
            "header": [
              {
                "key": "Origin",
                "value": "https://evil.example.com"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "POST"
              }
            ],
            "url": {
              "raw": "{{gatewayBaseUrl}}/api/v1/patients",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "patients"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 403', function () { pm.response.to.have.status(403); });",
                  "pm.test('No Allow-Origin header', function () { pm.expect(pm.response.headers.has('Access-Control-Allow-Origin')).to.be.false; });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 - Rate limit (run last)",
      "item": [
        {
          "name": "11th login from this IP within a minute (429)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gatewayBaseUrl}}/api/v1/auth/login",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"ratelimit.{{runId}}@careround.test\",\n  \"password\": \"wrong-password\"\n}"
            },
            "description": "Limit: app.rate-limit.login-per-minute (default 10) per client IP, fixed one-minute windows. If the run straddles a minute boundary the count resets; re-run."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Ten logins first (wrong password: rejected by auth-service, but each still counts against the per-IP limit).",
                  "for (let i = 0; i < 10; i++) {",
                  "    pm.sendRequest({ url: pm.environment.get('gatewayBaseUrl') + '/api/v1/auth/login', method: 'POST',",
                  "        header: { 'Content-Type': 'application/json' },",
                  "        body: { mode: 'raw', raw: JSON.stringify({ identifier: 'ratelimit.' + pm.environment.get('runId') + '@careround.test', password: 'wrong-password' }) } }, () => {});",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 429', function () { pm.response.to.have.status(429); });",
                  "pm.test('Error body {status, error, message, timestamp}', function () {",
                  "    pm.expect(Object.keys(pm.response.json()).sort()).to.eql(['error', 'message', 'status', 'timestamp']);",
                  "});",
                  "pm.test('Retry-After set', function () { pm.expect(Number(pm.response.headers.get('Retry-After'))).to.be.above(0); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}