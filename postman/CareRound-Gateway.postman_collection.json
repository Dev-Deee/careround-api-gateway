{
  "info": {
    "_postman_id": "7d8722b9-e3c2-4521-95ff-f091e8c8abf6",
    "name": "CareRound - API Gateway",
    "description": "Gateway behaviour on :8080: public routes, consistent 401s, route order (notification /wards/{id}/alerts vs ward /wards/{id}), 404 for unrouted paths, X-Request-Id, CORS and the login rate limit (429).\nSet superAdminPassword in the environment. Run the folders in order; folder 05 uses up this IP's login allowance for up to a minute.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Public routes",
      "item": [
        {
          "name": "Login - Super Admin, public (200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gatewayBaseUrl}}/api/v1/auth/login",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{superAdminEmail}}\",\n  \"password\": \"{{superAdminPassword}}\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Capture token + runId', function () {",
                  "    pm.environment.set('superAdminAccessToken', pm.response.json().accessToken);",
                  "    pm.environment.set('runId', String(Date.now()).slice(-8));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "JWKS, public (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayBaseUrl}}/.well-known/jwks.json",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                ".well-known",
                "jwks.json"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Activation page, public (400 without token, from auth-service)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayBaseUrl}}/api/v1/auth/activate-account",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "activate-account"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Reaches auth-service without a JWT (not a gateway 401)', function () { pm.expect(pm.response.code).to.not.eql(401); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Gateway health (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayBaseUrl}}/actuator/health",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('UP', function () { pm.expect(pm.response.json().status).to.eql('UP'); });"
                ]
              }
